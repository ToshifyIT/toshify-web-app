# MCP Server - Toshify Leads
FROM node:22-alpine

WORKDIR /app

# Copy package files and install production dependencies
# vendor/ holds the patched SheetJS tarball referenced as a file: dependency in
# package.json; npm ci needs it present even though the MCP server doesn't use xlsx.
COPY package*.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev --ignore-scripts

# Copy MCP server, docs, and the shared lib/routes modules
COPY mcp/ ./mcp/

# Relación pantallas -> tablas generada desde el código de la app en cada publicación:
# un módulo nuevo (ruta en HomePage.tsx) entra solo al MCP con sus tablas. src/ se copia
# solo para leerlo y se borra. Si el generador falla queda el pantallasDatos.js del repo.
COPY src/ ./src/
RUN node mcp/generadores/generarPantallasDatos.mjs \
  || echo "AVISO: no se pudo regenerar mcp/lib/pantallasDatos.js; se usa el del repo"; \
  rm -rf ./src

# Expose MCP port
EXPOSE 3002

ENV MCP_PORT=3002

# Start the MCP server
CMD ["node", "mcp/server.js"]
